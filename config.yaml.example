# Bu dosyayı kopyalayıp kendi değerlerinle doldur:
#   cp config.yaml.example config.yaml
#
# config.yaml gitignore'da — gerçek kimlik bilgilerini asla commit etme.
# Alternatif olarak MONGODB_URI / DB_NAME ortam değişkenlerini tanımlayabilirsin;
# ortam değişkenleri bu dosyadaki değerleri geçersiz kılar.

mongodb_uri: mongodb+srv://<kullanici>:<parola>@<cluster>.mongodb.net/
db_name: support

# python3 -c "import secrets; print(secrets.token_urlsafe(48))" ile üret
jwt_secret: <rastgele-uzun-bir-dize>

# OpenRouter — LLM öneri/özet üretimi (opsiyonel). Boşsa LLM özellikleri kapalı.
# Ucuz model seç: girdi+çıktı 1M'de < 0.50 USD (ör. gemini-2.0-flash-lite).
# openrouter_api_key: sk-or-v1-...
# openrouter_model: google/gemini-2.0-flash-lite-001
