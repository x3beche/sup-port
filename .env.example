# docker-compose / Portainer stack ortam değişkenleri.
# Bu dosyayı kopyalayıp doldur:  cp .env.example .env
# .env gitignore'ludur, gerçek kimlik bilgilerini ASLA commit etme.
# Portainer'da bunları stack'in "Environment variables" alanına da girebilirsin.

# MongoDB Atlas bağlantı dizesi (config.yaml'daki mongodb_uri ile aynı)
MONGODB_URI=mongodb+srv://<kullanici>:<parola>@<cluster>.mongodb.net/

# Veritabanı adı — container adında da kullanılır (fastapi-backend-<DB_NAME>-app)
DB_NAME=support

# JWT imzalama anahtarı. Üretmek için:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<rastgele-uzun-bir-dize>

# Backend'in dinleyeceği port (opsiyonel)
PORT=4000

# Token ömürleri (opsiyonel). Access kısa + refresh uzun: çalınan bir access
# token yalnızca dakikalar geçerli, refresh token tek kullanımlık ve iptal
# edilebilir. Refresh token rotation'lıdır (her kullanımda yenisiyle değişir).
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=30

# CORS izinli origin'ler — virgülle ayır (opsiyonel, varsayılan "*").
# Native uygulama CORS kullanmaz; bu yalnızca web istemcisini ilgilendirir.
# Production'da web origin'ine sabitle:
# CORS_ORIGINS=https://app.example.com

# İzinli Host başlıkları — virgülle ayır (opsiyonel, varsayılan "*").
# Host-header injection'a karşı production'da kendi alan adına sabitle:
# ALLOWED_HOSTS=support.medipol.dev

# Backend bir ters proxy (Traefik/nginx) ARKASINDAYSA true yap. Böylece hız
# sınırlayıcı gerçek istemci IP'sini X-Forwarded-For'dan okur. Proxy yoksa
# false BIRAK: aksi halde başlık taklit edilerek IP limiti atlatılabilir.
# TRUST_FORWARDED_FOR=false

# OpenRouter — LLM öneri/özet üretimi (opsiyonel). Boşsa LLM özellikleri kapalı.
# Ucuz model seç: girdi+çıktı 1M'de < 0.50 USD.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
